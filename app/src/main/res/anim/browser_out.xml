<?xml version="1.0" encoding="utf-8"?>
<!-- NSXL Web closing: drops away and fades, revealing Home behind it. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic"
    android:duration="260"
    android:zAdjustment="top">
    <alpha android:fromAlpha="1" android:toAlpha="0" />
    <translate android:fromYDelta="0" android:toYDelta="8%" />
    <scale android:fromXScale="1" android:toXScale="0.97" android:fromYScale="1" android:toYScale="0.97"
        android:pivotX="50%" android:pivotY="50%" />
</set>
