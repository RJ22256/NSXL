<?xml version="1.0" encoding="utf-8"?>
<!-- NSXL Web opening: rises into place from just below, like a panel sliding up. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:duration="340">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220" />
    <translate android:fromYDelta="9%" android:toYDelta="0" />
    <scale android:fromXScale="0.96" android:toXScale="1" android:fromYScale="0.96" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
</set>
