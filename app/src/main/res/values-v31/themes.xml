<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: a black splash with the Orbit icon, which hands over straight to the start-up animation. -->
    <style name="LauncherTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ic_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowSplashScreenBackground">@color/ic_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_bg</item>
    </style>
</resources>
