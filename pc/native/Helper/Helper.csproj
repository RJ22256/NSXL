<Project Sdk="Microsoft.NET.Sdk">
  <!--
    nsxl-native.exe: small Windows helper for NSXL for Windows.
    Built on .NET Framework 4.8 (already part of Windows 10/11), so nothing extra to install.
    NSXL starts it and talks to it with one JSON message per line on stdin/stdout.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>nsxl-native</AssemblyName>
    <RootNamespace>Nsxl.Native</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>NSXL</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.3233" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
